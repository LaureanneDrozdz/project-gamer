generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TargetType {
  CHALLENGE
  PARTICIPATION
}

enum Roles {
  USER
  ADMIN
}

model User {
  id             String          @id @default(uuid())
  userName       String          @unique
  email          String          @unique
  password_hash  String
  avatar_url     String
  created_at     DateTime        @default(now())
  challenges     Challenge[]     @relation("CreatedChallenges")
  participations Participation[]
  votes          Vote[]
  role           Roles           @default(USER)
  notifications  Notification[]
  sent_notifications Notification[] @relation("ActorNotifications")
}

model Challenge {
  id          String     @id @default(uuid())
  title       String
  description String
  rules       String
  game        String
  difficulty  Difficulty
  user_id      String
  validated   Boolean
  created_at  DateTime   @default(now())
  creator     User       @relation("CreatedChallenges", fields: [user_id], references: [id], onDelete: Cascade)
  votes       Vote[]    
  participations Participation[]
  image_url String?
}

model Participation {
  id           String   @id @default(uuid())
  user_id      String
  challenge_id String
  video_url    String
  description  String
  validated    Boolean
  created_at   DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge    Challenge     @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  votes        Vote[]  
}

model Vote {
  id               String         @id @default(uuid())
  user_id           String
  challenge_id     String?
  participation_id String?
  target_type      TargetType
  created_at       DateTime       @default(now())
  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge        Challenge?     @relation(fields: [challenge_id], references: [id])
  participation    Participation? @relation(fields: [participation_id], references: [id])
}

enum NotificationAction {
  LIKE
}

model Notification {
  id         String              @id @default(uuid())
  user_id    String
  actor_id   String
  action     NotificationAction
  target_type TargetType
  target_id  String
  read       Boolean             @default(false)
  created_at DateTime            @default(now())
  user       User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  actor      User                @relation("ActorNotifications", fields: [actor_id], references: [id], onDelete: Cascade)
  @@unique([actor_id, target_type, target_id, action])
}
